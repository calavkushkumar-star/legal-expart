rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return signedIn() && userExists(request.auth.uid) && userRole() == 'admin'; }
    function isCustomer() { return signedIn() && userExists(request.auth.uid) && userRole() == 'customer'; }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.role == 'customer';
      allow update, delete: if isAdmin();
    }
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
    match /services/{serviceId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /offers/{offerId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /serviceForms/{formId} {
      allow get, list: if isAdmin() || (isCustomer() && resource.data.isActive == true);
      allow create, update, delete: if isAdmin();
    }
    match /serviceRequests/{requestId} {
      allow create: if isCustomer() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'Pending';
      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}